{
    "version": "2.0.0",
    "tasks": [
        {
            // Builds the backend (generate.web) with the user-local .NET 10 SDK
            // (machine-wide SDK is 9.x; global.json pins 10.x). Building generate.web
            // also builds ClientApp on first run via the csproj DebugEnsureNodeEnv target,
            // so Node 22.20 is placed on PATH for that child npm process.
            "label": "build-backend",
            "type": "process",
            "command": "${env:USERPROFILE}\\.dotnet\\dotnet.exe",
            "args": [
                "build",
                "${workspaceFolder}/generate.web/generate.web.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "options": {
                "env": {
                    "DOTNET_ROOT": "${env:USERPROFILE}\\.dotnet",
                    "PATH": "${env:USERPROFILE}\\.dotnet;${env:LOCALAPPDATA}\\node-v22.20.0-win-x64;${env:PATH}"
                }
            },
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            // Builds the background worker (generate.background) with the user-local .NET 10 SDK.
            "label": "build-background",
            "type": "process",
            "command": "${env:USERPROFILE}\\.dotnet\\dotnet.exe",
            "args": [
                "build",
                "${workspaceFolder}/generate.background/generate.background.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "options": {
                "env": {
                    "DOTNET_ROOT": "${env:USERPROFILE}\\.dotnet",
                    "PATH": "${env:USERPROFILE}\\.dotnet;${env:PATH}"
                }
            },
            "problemMatcher": "$msCompile",
            "group": "build"
        },
        {
            // Optional: run the Angular dev server standalone on http://localhost:4200
            // (not needed for F5 - the backend's SPA middleware starts Angular itself).
            // Uses the user-local Node 22.20 because Angular CLI 20 requires Node >= 22.12.
            "label": "angular-serve",
            "type": "shell",
            "command": "npm start",
            "options": {
                "cwd": "${workspaceFolder}/generate.web/ClientApp",
                "env": {
                    "PATH": "${env:LOCALAPPDATA}\\node-v22.20.0-win-x64;${env:PATH}"
                }
            },
            "isBackground": true,
            "problemMatcher": []
        }
    ]
}
